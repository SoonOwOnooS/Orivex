{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orivex",
  "main": "./build/sites-worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orivex-db",
      "database_id": "cb78c44c-81b1-4e24-99b7-233773939eb6",
      "migrations_dir": "./drizzle",
    },
  ],
  // Public production login settings. Override them in .dev.vars for local login.
  // Keep AUTH_GITHUB_CLIENT_SECRET in Cloudflare secrets, never in this file.
  "vars": {
    "AUTH_GITHUB_CLIENT_ID": "Ov23liaf8vV4NiFXlnmu",
    "AUTH_ORIGIN": "https://orivex.real-videogame.workers.dev",
  },
  "keep_vars": true,
}
