{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orivex",
  "main": "./build/sites-worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orivex-db",
      "database_id": "cb78c44c-81b1-4e24-99b7-233773939eb6",
      "migrations_dir": "./drizzle",
    },
  ],
  // Keep login settings managed in the Cloudflare dashboard when deploying.
  // Local login settings belong in .dev.vars. Never commit the client secret.
  "keep_vars": true,
}
